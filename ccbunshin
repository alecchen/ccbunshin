#!/usr/bin/env bash
set -euo pipefail

PROFILES_DIR="${CCBUNSHIN_PROFILES_DIR:-$HOME/.claude-profiles}"
GLOBAL_SETTINGS="$HOME/.claude/settings.json"
WRAPPER_START="# >>> ccbunshin wrappers >>>"
WRAPPER_END="# <<< ccbunshin wrappers <<<"

 die() { printf 'ccbunshin: %s\n' "$*" >&2; exit 1; }
 usage() {
  cat <<'EOF'
Usage:
  ccbunshin init
  ccbunshin create <name> [--from <file>] [--force]
  ccbunshin launch <name> [claude args...]
  ccbunshin model <name> <model>
  ccbunshin list
  ccbunshin status <name>
  ccbunshin doctor [name] [--fix]
  ccbunshin delete <name>
  ccbunshin uninstall
EOF
 }

 valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; }
 profile_path() {
  valid_name "$1" || die "invalid profile name: $1"
  printf '%s/%s.json\n' "$PROFILES_DIR" "$1"
 }
 ensure_profiles_dir() { mkdir -p "$PROFILES_DIR"; chmod 700 "$PROFILES_DIR"; }

 validate_json() {
  local file=$1
  [[ -f "$file" ]] || { printf 'missing file\n'; return 1; }
  if command -v jq >/dev/null 2>&1; then
   jq empty "$file" >/dev/null 2>&1 || { printf 'invalid JSON\n'; return 1; }
  elif command -v python3 >/dev/null 2>&1; then
   python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$file" >/dev/null 2>&1 || { printf 'invalid JSON\n'; return 1; }
  else
   grep -q '^{' "$file" || { printf 'invalid JSON\n'; return 1; }
   grep -q '}' "$file" || { printf 'invalid JSON\n'; return 1; }
  fi
 }

 has_key() { grep -Eq '"'"$2"'"[[:space:]]*:' "$1"; }
 read_model() {
  local file=$1
  if command -v jq >/dev/null 2>&1; then jq -r '.model // ""' "$file"
  elif command -v python3 >/dev/null 2>&1; then python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("model", ""))' "$file"
  else sed -nE 's/.*"model"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$file" | head -n 1
  fi
 }

 write_model() {
  local file=$1 model=$2 tmp
  tmp=$(mktemp "${file}.XXXXXX")
  if command -v jq >/dev/null 2>&1; then
   jq --arg model "$model" '.model = $model' "$file" >"$tmp"
  elif command -v python3 >/dev/null 2>&1; then
   python3 - "$file" "$model" >"$tmp" <<'PY'
import json, sys
path, model = sys.argv[1:]
with open(path) as f:
    data = json.load(f)
data["model"] = model
print(json.dumps(data, indent=2))
PY
  else
   awk -v model="$model" 'BEGIN { done=0 } /"model"[[:space:]]*:/ && !done { sub(/:[[:space:]]*"[^"]*"/, ": \"" model "\""); done=1 } { print }' "$file" >"$tmp"
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$file"
 }

 scaffold() {
  cat <<'EOF'
{
  "env": {},
  "hooks": {},
  "model": ""
}
EOF
 }

 create_profile() {
  local name=$1 source=${2:-} force=${3:-false} file
  ensure_profiles_dir
  file=$(profile_path "$name")
  [[ ! -e "$file" || "$force" == true ]] || die "profile exists: $name (use --force to replace)"
  if [[ -n "$source" ]]; then
   [[ -f "$source" ]] || die "template not found: $source"
   validate_json "$source" || die "template is not valid JSON: $source"
   cp "$source" "$file"
  else scaffold >"$file"; fi
  chmod 600 "$file"
  printf 'created %s\n' "$file"
 }

 install_shell_wrappers() {
  local rc
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
   touch "$rc"
   if ! grep -Fq "$WRAPPER_START" "$rc"; then
    cat >>"$rc" <<EOF

$WRAPPER_START
ccbunshin() { command "$PWD/ccbunshin" "\$@"; }
$WRAPPER_END
EOF
    printf 'installed wrapper in %s\n' "$rc"
   fi
  done
 }
 remove_shell_wrappers() {
  local rc tmp
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
   [[ -f "$rc" ]] || continue
   tmp=$(mktemp "${rc}.XXXXXX")
   awk -v start="$WRAPPER_START" -v end="$WRAPPER_END" '$0 == start { skip=1; next } $0 == end { skip=0; next } !skip { print }' "$rc" >"$tmp"
   chmod 600 "$tmp"; mv "$tmp" "$rc"
  done
 }

 list_profiles() {
  ensure_profiles_dir
  local file name model
  shopt -s nullglob
  for file in "$PROFILES_DIR"/*.json; do
   name=${file##*/}; name=${name%.json}
   validate_json "$file" >/dev/null || { printf '%s\tinvalid JSON\n' "$name"; continue; }
   model=$(read_model "$file")
   printf '%s\tmodel=%s\n' "$name" "${model:-<unset>}"
  done
 }

 status_profile() {
  local name=$1 file
  file=$(profile_path "$name")
  [[ -f "$file" ]] || die "profile not found: $name"
  printf 'profile: %s\n' "$file"
  printf 'permissions: %s\n' "$(stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file")"
  if [[ -f "$GLOBAL_SETTINGS" ]] && command -v diff >/dev/null 2>&1; then
   diff -u "$GLOBAL_SETTINGS" "$file" || true
  fi
 }

 doctor_profile() {
  local name=$1 file warning=0
  file=$(profile_path "$name")
  [[ -f "$file" ]] || { printf 'ERROR %s: profile not found\n' "$name"; return 1; }
  if ! validate_json "$file"; then printf 'ERROR %s: invalid JSON\n' "$name"; warning=1; fi
  for key in env hooks model; do
   has_key "$file" "$key" || { printf 'WARN %s: missing key %s\n' "$name" "$key"; warning=1; }
  done
  [[ "$(stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file")" == 600 ]] || { printf 'WARN %s: permissions are not 600\n' "$name"; warning=1; }
  return "$warning"
 }

 doctor() {
  local name result=0
  [[ "${1:-}" == --fix ]] && shift
  if [[ -n "${1:-}" ]]; then doctor_profile "$1" || result=1
  else
   ensure_profiles_dir
   local file n
   shopt -s nullglob
   for file in "$PROFILES_DIR"/*.json; do n=${file##*/}; n=${n%.json}; doctor_profile "$n" || result=1; done
  fi
  if [[ -f "$GLOBAL_SETTINGS" ]] && grep -Eq 'ANTHROPIC_(BASE_URL|AUTH_TOKEN|API_KEY)|"hooks"[[:space:]]*:|"model"[[:space:]]*:' "$GLOBAL_SETTINGS"; then
   printf 'WARN global settings contains endpoint, auth, hooks, or model keys\n'
   result=1
  fi
  return "$result"
 }

 main() {
  local command=${1:-}; shift || true
  case "$command" in
   init) ensure_profiles_dir; install_shell_wrappers; printf 'initialized %s\n' "$PROFILES_DIR" ;;
   create)
    [[ $# -ge 1 ]] || die 'create requires a name'
    local name=$1 source='' force=false; shift
    while [[ $# -gt 0 ]]; do case "$1" in --from) source=${2:?missing template}; shift 2;; --force) force=true; shift;; *) die "unknown create option: $1";; esac; done
    create_profile "$name" "$source" "$force" ;;
   launch)
    [[ $# -ge 1 ]] || die 'launch requires a profile name'
    local name=$1; shift; file=$(profile_path "$name"); [[ -f "$file" ]] || die "profile not found: $name"; [[ -f "$HOME/.bashrc" || -f "$HOME/.zshrc" ]] || install_shell_wrappers; exec claude --settings "$file" "$@" ;;
   model) [[ $# == 2 ]] || die 'model requires a profile name and model'; file=$(profile_path "$1"); [[ -f "$file" ]] || die "profile not found: $1"; write_model "$file" "$2"; printf 'updated %s\n' "$file" ;;
   list) list_profiles ;;
   status) [[ $# == 1 ]] || die 'status requires a profile name'; status_profile "$1" ;;
   doctor) doctor "$@" ;;
   delete) [[ $# == 1 ]] || die 'delete requires a profile name'; file=$(profile_path "$1"); [[ -f "$file" ]] || die "profile not found: $1"; rm "$file"; printf 'deleted %s\n' "$file" ;;
   uninstall) remove_shell_wrappers; printf 'removed ccbunshin wrappers\n' ;;
   -h|--help|help|'') usage ;;
   *) die "unknown command: $command" ;;
  esac
 }

main "$@"
