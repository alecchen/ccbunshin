{
  "port": 3456,
  "providers": {
    "provider1": {
      "upstream": "https://provider1.example.invalid",
      "models": {
        "claude-opus-4-1": "claude-opus-4-1"
      }
    },
    "provider2": {
      "upstream": "https://provider2.example.invalid",
      "dialect": "openai-chat",
      "default_model": "oss-model"
    }
  },
  "routes": [
    {
      "pattern": "claude-*",
      "provider": "provider1"
    },
    {
      "pattern": "deepseek-*",
      "provider": "provider2"
    },
    {
      "pattern": "qwen-3.8-27b",
      "provider": "provider2"
    },
    {
      "pattern": "gpt-oss-120b",
      "provider": "provider2"
    }
  ]
}
